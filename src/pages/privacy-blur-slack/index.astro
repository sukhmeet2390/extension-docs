---
import Base from '../../layouts/Base.astro';
import WhatIsBlock from '../../components/WhatIsBlock.astro';
import RelatedContentBlock from '../../components/RelatedContentBlock.astro';
import FeatureCard from '../../components/FeatureCard.astro';
import FaqItem from '../../components/FaqItem.astro';

const cwsLink = 'https://chromewebstore.google.com/detail/privacy-blur-for-slack/cejmffebfhdnhbjkhiobaecdohheimkj';
const heroImage = '/assets/screenshots/privacy-blur-slack/hero.png';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "Privacy Blur for Slack",
      "description": "Chrome extension that blurs and hides sensitive Slack messages, names, and channels during screen sharing or video calls. One-click toggle with hover-to-reveal.",
      "applicationCategory": "BrowserExtension",
      "operatingSystem": "Chrome",
      "offers": [
        { "@type": "Offer", "price": "0", "priceCurrency": "USD", "description": "Free tier with basic blur" },
        { "@type": "Offer", "price": "3", "priceCurrency": "USD", "description": "Pro monthly — persistence, rules, shortcuts" }
      ],
      "url": "https://amrita-labs.com/privacy-blur-slack/",
      "installUrl": cwsLink,
      "author": { "@type": "Organization", "name": "Amrita Labs", "url": "https://amrita-labs.com" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "Is Privacy Blur for Slack free?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Basic blur (all 9 zones, hover-to-reveal, keyboard shortcut) is free forever. Pro adds persistence across reloads, custom keyword rules, and sender rules for $3/month." }},
        { "@type": "Question", "name": "Can the extension read my Slack messages?", "acceptedAnswer": { "@type": "Answer", "text": "No. Privacy Blur applies CSS blur effects to the page DOM. It cannot read, store, or transmit your message content. Everything runs 100% client-side in your browser." }},
        { "@type": "Question", "name": "Does it work during Zoom and Google Meet calls?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. When you share your screen or a Slack tab during any video call, blurred content stays blurred for everyone on the call. Only you can hover to reveal." }},
        { "@type": "Question", "name": "Will it slow down Slack?", "acceptedAnswer": { "@type": "Answer", "text": "No. The extension is under 130KB and uses CSS blur with a lightweight MutationObserver. Zero impact on Slack's performance or load time." }},
        { "@type": "Question", "name": "Does it work with Slack Desktop app?", "acceptedAnswer": { "@type": "Answer", "text": "Privacy Blur works on Slack Web (app.slack.com) in Chrome. The Slack desktop app uses its own renderer and does not support Chrome extensions." }}
      ]
    }
  ]
};
---

<Base
  title="Privacy Blur for Slack — Hide Messages During Screen Sharing"
  description="Chrome extension that blurs and hides sensitive Slack messages, names, and channels during screen sharing or video calls. One-click toggle with hover-to-reveal."
  canonical="https://amrita-labs.com/privacy-blur-slack/"
  schema={schema}
  ogImage={heroImage}
  breadcrumbs={[
    { name: 'Home', url: 'https://amrita-labs.com/' },
    { name: 'Chrome Extensions', url: 'https://amrita-labs.com/chrome-extensions/' },
    { name: 'Privacy Blur for Slack', url: 'https://amrita-labs.com/privacy-blur-slack/' },
  ]}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-violet-500/10 via-transparent to-transparent"></div>
    <div class="max-w-6xl mx-auto px-6 pt-24 pb-16 sm:pt-32 relative">
      <div class="max-w-2xl">
        <span class="inline-block text-xs font-semibold text-violet-300 bg-violet-950/50 px-3 py-1.5 rounded-full border border-violet-500/20 uppercase tracking-wider">Chrome Extension</span>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-white mt-6 leading-tight tracking-tight">
          Share your screen,<br />not your secrets.
        </h1>
        <p class="text-lg text-gray-400 mt-6 leading-relaxed">
          Privacy Blur for Slack hides sensitive messages, names, and channels during screen sharing or video calls. One click to blur — hover to reveal only for your eyes.
        </p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href={cwsLink} class="inline-flex items-center gap-2 bg-violet-600 text-white px-6 py-3 rounded-full font-semibold text-sm hover:bg-violet-500 transition-colors shadow-lg shadow-violet-600/25">
            Install Free — Chrome Web Store
          </a>
        </div>
        <p class="text-xs text-gray-400 mt-3">Free forever · Pro from $3/mo · No signup</p>
      </div>
    </div>
  </section>

  <!-- Hero Screenshot -->
  <section class="max-w-6xl mx-auto px-6 pb-16">
    <div class="rounded-2xl overflow-hidden border border-white/10 shadow-2xl shadow-black/30">
      <img src={heroImage} alt="Privacy Blur for Slack hiding messages during screen sharing" class="w-full h-auto" loading="lazy" />
    </div>
  </section>

  <!-- How it works -->
  <section class="max-w-6xl mx-auto px-6 pb-20">
    <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-8">How it works</h2>
    <div class="grid sm:grid-cols-3 gap-6 animate-in">
      <div class="flex gap-4">
        <span class="flex-shrink-0 w-8 h-8 bg-violet-600 text-white font-bold rounded-full flex items-center justify-center text-sm">1</span>
        <div>
          <h3 class="font-semibold text-white">Open Slack Web</h3>
          <p class="text-sm text-gray-400 mt-1">Navigate to app.slack.com. The Privacy Blur widget appears automatically in the bottom-right corner.</p>
        </div>
      </div>
      <div class="flex gap-4">
        <span class="flex-shrink-0 w-8 h-8 bg-violet-600 text-white font-bold rounded-full flex items-center justify-center text-sm">2</span>
        <div>
          <h3 class="font-semibold text-white">Toggle blur zones</h3>
          <p class="text-sm text-gray-400 mt-1">Click the widget to blur messages, names, channels, or media. Use Alt+Shift+B for instant global toggle.</p>
        </div>
      </div>
      <div class="flex gap-4">
        <span class="flex-shrink-0 w-8 h-8 bg-violet-600 text-white font-bold rounded-full flex items-center justify-center text-sm">3</span>
        <div>
          <h3 class="font-semibold text-white">Hover to reveal</h3>
          <p class="text-sm text-gray-400 mt-1">Hover over any blurred content to read it yourself — but the blur stays on for everyone watching your screen share.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="bg-surface-900 border-t border-white/5">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-8">9 Independent Blur Zones</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 animate-in">
        <FeatureCard icon="💬" title="Messages" description="Blur all message text in conversations and threads." />
        <FeatureCard icon="👤" title="Names" description="Hide sender names so nobody knows who said what." />
        <FeatureCard icon="📁" title="Channels" description="Blur the sidebar channel list — hide what teams you're in." />
        <FeatureCard icon="🖼️" title="Media" description="Blur images, files, and link previews shared in chat." />
        <FeatureCard icon="⌨️" title="Shortcuts" description="Alt+Shift+B global toggle. Per-zone shortcuts with Pro." />
        <FeatureCard icon="🔄" title="Persistence" description="Pro: settings survive page reloads. No re-toggling each morning." />
      </div>
    </div>
  </section>

  <!-- Pro section -->
  <section class="max-w-6xl mx-auto px-6 py-20">
    <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-8">Pro Features</h2>
    <div class="max-w-2xl">
      <ul class="space-y-4 text-gray-300">
        <li class="flex gap-3"><span class="text-violet-300">✓</span> Persist blur settings across page reloads</li>
        <li class="flex gap-3"><span class="text-violet-300">✓</span> Custom keyword rules — auto-blur "salary", "offer", "confidential"</li>
        <li class="flex gap-3"><span class="text-violet-300">✓</span> Sender rules — automatically blur all messages from specific people</li>
        <li class="flex gap-3"><span class="text-violet-300">✓</span> Per-zone keyboard shortcuts (Alt+Shift+1 through 9)</li>
        <li class="flex gap-3"><span class="text-violet-300">✓</span> Priority email support</li>
      </ul>
      <p class="text-sm text-gray-500 mt-6">7-day free trial · $3/month or $29/year · Cancel anytime</p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-t border-white/5 bg-surface-900">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-8">Frequently asked questions</h2>
      <div class="max-w-2xl">
        <FaqItem question="Is Privacy Blur for Slack free?" answer="Yes. Basic blur (all 9 zones, hover-to-reveal, keyboard shortcut) is free forever. Pro adds persistence across reloads, custom keyword rules, and sender rules for $3/month." />
        <FaqItem question="Can the extension read my Slack messages?" answer="No. Privacy Blur applies CSS blur effects to the page DOM. It cannot read, store, or transmit your message content. Everything runs 100% client-side in your browser." />
        <FaqItem question="Does it work during Zoom and Google Meet calls?" answer="Yes. When you share your screen or a Slack tab during any video call, blurred content stays blurred for everyone on the call. Only you can hover to reveal." />
        <FaqItem question="Will it slow down Slack?" answer="No. The extension is under 130KB and uses CSS blur with a lightweight MutationObserver. Zero impact on Slack's performance or load time." />
        <FaqItem question="Does it work with Slack Desktop app?" answer="Privacy Blur works on Slack Web (app.slack.com) in Chrome. The Slack desktop app uses its own renderer and does not support Chrome extensions." />
      </div>
    </div>
  </section>

  <!-- Related reading -->
  <section class="border-t border-white/5 bg-surface-900">
    <div class="max-w-6xl mx-auto px-6 py-16">
      <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-6">Related reading</h2>
      <ul class="space-y-3 text-sm">
        <li><a href="/blog/best-chrome-extensions-screen-sharing-privacy/" class="text-violet-400 hover:text-violet-300 transition-colors">Best Chrome extensions for screen sharing privacy (2026)</a></li>
        <li><a href="/blog/hide-slack-messages-screen-sharing/" class="text-violet-400 hover:text-violet-300 transition-colors">How to hide Slack messages during screen sharing — 6 practical options</a></li>
        <li><a href="/chrome-extensions/" class="text-violet-400 hover:text-violet-300 transition-colors">All Amrita Labs Chrome extensions</a></li>
      </ul>
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-white/5 bg-surface-800">
    <div class="max-w-6xl mx-auto px-6 py-16 text-center">
      <h2 class="text-2xl sm:text-3xl font-bold text-white">Screen share with confidence.</h2>
      <p class="text-gray-400 mt-3 text-lg">Free to install. Blurs instantly. No signup needed.</p>
      <a href={cwsLink} class="inline-flex items-center gap-2 bg-violet-600 text-white px-8 py-3 rounded-full font-semibold text-sm mt-8 hover:bg-violet-500 transition-colors shadow-lg shadow-violet-600/25">
        Install Free — Chrome Web Store
      </a>
    </div>
  </section>

  <!-- Legal -->
  <WhatIsBlock productName="Privacy Blur for Slack" definition="Privacy Blur for Slack is a free Chrome extension that blurs sensitive Slack content — messages, channel names, DMs, avatars, and media — before or during screen sharing. It has nine independent blur zones, hover-to-reveal for private viewing, and an Alt+Shift+B keyboard shortcut. Runs 100% client-side; Slack data never leaves the browser." />
  <!-- RelatedContentBlock reverse-index -->
  <RelatedContentBlock productSlug="privacy-blur-slack" productSlugs={['privacy-blur-discord', 'privacy-blur-teams', 'privacy-blur-whatsapp']} theme="dark" />


  <div class="max-w-6xl mx-auto px-6 py-8 flex gap-6 text-xs text-gray-500">
    <a href="/privacy-blur-slack/privacy" class="hover:text-gray-400">Privacy Policy</a>
    <a href="/privacy-blur-slack/terms/" class="hover:text-gray-400">Terms of Service</a>
    <a href="mailto:hello@amrita-labs.com" class="hover:text-gray-400">hello@amrita-labs.com</a>
    <a href="/" class="hover:text-gray-400">← Back to Amrita Labs</a>
  </div>
</Base>