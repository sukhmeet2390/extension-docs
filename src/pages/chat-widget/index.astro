---
import Base from '../../layouts/Base.astro';
import WhatIsBlock from '../../components/WhatIsBlock.astro';
import RelatedContentBlock from '../../components/RelatedContentBlock.astro';
import FeatureCard from '../../components/FeatureCard.astro';
import FaqItem from '../../components/FaqItem.astro';

const heroImage = '/assets/screenshots/chat/hero.png';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "Amrita Chat Widget",
      "description": "Multi-channel chat button widget for Shopify stores. Connect nine customer contact channels without a separate chat account.",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "url": "https://amrita-labs.com/chat-widget/",
      "author": { "@type": "Organization", "name": "Amrita Labs", "url": "https://amrita-labs.com" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "Do I need to create an account?", "acceptedAnswer": { "@type": "Answer", "text": "No separate chat account is required. Configure the channels you already use, and visitors open them directly from your storefront." }},
        { "@type": "Question", "name": "Is it free?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. The core chat widget is free. Install from the Shopify App Store." }},
        { "@type": "Question", "name": "Will it slow down my store?", "acceptedAnswer": { "@type": "Answer", "text": "No. The widget is under 15KB and loads asynchronously. Zero impact on page speed." }}
      ]
    }
  ]
};
---

<Base
  title="Shopify Chat Widget — WhatsApp, Messenger, Instagram + More"
  description="Free Shopify chat widget for WhatsApp, Messenger, Instagram, Telegram, LINE, Viber, SMS, Email, and Phone in one floating button. No separate chat account."
  canonical="https://amrita-labs.com/chat-widget/"
  schema={schema}
  ogImage={heroImage}
  breadcrumbs={[
    { name: 'Home', url: 'https://amrita-labs.com/' },
    { name: 'Amrita Chat Widget', url: 'https://amrita-labs.com/chat-widget/' },
  ]}
>
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-green-500/10 via-transparent to-transparent"></div>
    <div class="max-w-6xl mx-auto px-6 pt-24 pb-16 sm:pt-32 relative">
      <div class="max-w-2xl">
        <span class="inline-block text-xs font-semibold text-green-300 bg-green-950/50 px-3 py-1.5 rounded-full border border-green-500/20 uppercase tracking-wider">Shopify App</span>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-white mt-6 leading-tight tracking-tight">
          Free Shopify chat widget for<br />WhatsApp, Messenger, Instagram,<br />Telegram, LINE, Viber, SMS, Email, Phone.
        </h1>
        <p class="text-lg text-gray-400 mt-6 leading-relaxed">
          One floating button. Nine customer contact channels. No separate chat account. Free forever, no visitor cap, zero cookies.
        </p>
        <p class="text-xs text-gray-400 mt-6">Free · 9 channels · No separate chat account</p>
        <div class="flex flex-wrap gap-3 mt-6">
          <a href="https://apps.shopify.com/chat-widget-1" class="inline-flex items-center gap-2 bg-green-600 text-white px-6 py-3 rounded-full font-semibold text-sm hover:bg-green-500 transition-colors shadow-lg shadow-green-600/25">
            Install on Shopify
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Hero Screenshot -->
  <section class="max-w-6xl mx-auto px-6 pb-16">
    <div class="rounded-2xl overflow-hidden border border-white/10 shadow-2xl shadow-black/30">
      <img src={heroImage} alt="Amrita Chat Widget on a Shopify store" class="w-full h-auto" loading="lazy" />
    </div>
  </section>

  <section class="bg-surface-900 border-t border-white/5">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-8">Features</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 animate-in">
        <FeatureCard icon="💬" title="WhatsApp" description="Customers tap to open a WhatsApp conversation with your business number." />
        <FeatureCard icon="📱" title="Messenger" description="Connect your Facebook page. One tap opens Messenger chat." />
        <FeatureCard icon="📸" title="Instagram" description="Send visitors directly to your Instagram profile." />
        <FeatureCard icon="✈️" title="Telegram" description="Open a Telegram conversation with your business." />
        <FeatureCard icon="💭" title="LINE & Viber" description="Offer popular messaging channels alongside your other contact options." />
        <FeatureCard icon="💬" title="SMS" description="Open the visitor's messaging app with your number pre-filled." />
        <FeatureCard icon="📧" title="Email" description="Opens customer's email client with your address pre-filled." />
        <FeatureCard icon="📞" title="Phone" description="Click-to-call button. Works on mobile and desktop." />
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-20">
    <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-8">Frequently asked questions</h2>
    <div class="max-w-2xl">
      <FaqItem question="Do I need to create an account?" answer="No separate chat account is required. Configure the channels you already use, and visitors open them directly from your storefront." />
      <FaqItem question="Is it free?" answer="Yes. The core chat widget is free. Install from the Shopify App Store." />
      <FaqItem question="Will it slow down my store?" answer="No. The widget is under 15KB and loads asynchronously. Zero impact on page speed." />
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-6 py-8 flex gap-6 text-xs text-gray-500">
    <a href="/chat-widget/privacy/" class="hover:text-gray-400">Privacy Policy</a>
    <a href="/chat-widget/terms/" class="hover:text-gray-400">Terms of Service</a>
    <a href="/" class="hover:text-gray-400">← Back to Amrita Labs</a>
  </div>
  <WhatIsBlock productName="Amrita Chat Widget" definition="Amrita Chat Widget is a free Shopify app that adds one floating chat button to your store, connecting nine customer contact channels: WhatsApp, Messenger, Instagram, Telegram, LINE, Viber, SMS, Email, and Phone. No separate chat account required, zero cookies, no visitor cap. Ships with a nine-language admin interface." />
  <!-- RelatedContentBlock reverse-index -->
  <RelatedContentBlock productSlug="chat-widget" productSlugs={['cookie-consent', 'accessibility-widget']} theme="dark" />
</Base>
