---
import Base from '../../layouts/Base.astro';
import FeatureCard from '../../components/FeatureCard.astro';
import FaqItem from '../../components/FaqItem.astro';

const cwsLink = 'https://chromewebstore.google.com/detail/pinello/kmelegdnljikegoemigfgnpcbllmkije';
const heroImage = '/assets/screenshots/pinello/hero.png';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "Pinello",
      "description": "Pinello is a free Chrome extension that scores Pinterest pins across 5 dimensions — image, board fit, title, description, and hashtags — in real time.",
      "applicationCategory": "BrowserExtension",
      "operatingSystem": "Chrome",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "url": "https://amrita-labs.com/pinello/",
      "installUrl": cwsLink,
      "author": { "@type": "Organization", "name": "Amrita Labs", "url": "https://amrita-labs.com" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "Is Pinello free?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. 50 AI scores per month, no signup, no credit card. Structural scoring (image analysis, hashtag counting) is always unlimited." }},
        { "@type": "Question", "name": "What data does Pinello collect?", "acceptedAnswer": { "@type": "Answer", "text": "Only anonymous device ID for rate limiting. Title/description text sent to Azure OpenAI for AI features is processed ephemerally — never stored. Image analysis is 100% local in your browser." }},
        { "@type": "Question", "name": "Does Pinello modify my pins?", "acceptedAnswer": { "@type": "Answer", "text": "Never. AI rewrite suggestions are copy-to-clipboard only. You paste what you want. Pinello never auto-edits your pin content." }},
        { "@type": "Question", "name": "Does it work on all Pinterest domains?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Works on pinterest.com and all country variants (ca.pinterest.com, uk.pinterest.com, etc.) for personal, business, and creator accounts." }},
        { "@type": "Question", "name": "How is Pinello different from Tailwind?", "acceptedAnswer": { "@type": "Answer", "text": "Tailwind is a scheduling tool. Pinello scores your pin quality BEFORE you publish — image, board fit, title, description, and hashtags rated in real time inside the pin-creation modal." }}
      ]
    }
  ]
};
---

<Base
  title="Pinello — Free Pinterest Pin Scorer & SEO Checker"
  description="Pinello is a free Chrome extension that scores Pinterest pins across 5 dimensions — image, board fit, title, description, and hashtags — in real time."
  canonical="https://amrita-labs.com/pinello/"
  schema={schema}
  ogImage={heroImage}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-rose-500/10 via-transparent to-transparent"></div>
    <div class="max-w-6xl mx-auto px-6 pt-24 pb-16 sm:pt-32 relative">
      <div class="max-w-2xl">
        <span class="inline-block text-xs font-semibold text-rose-300 bg-rose-950/50 px-3 py-1.5 rounded-full border border-rose-500/20 uppercase tracking-wider">Chrome Extension</span>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-white mt-6 leading-tight tracking-tight">
          Stop guessing if<br />your pin will rank.
        </h1>
        <p class="text-lg text-gray-400 mt-6 leading-relaxed">
          Pinello is a free Chrome extension that scores Pinterest pins across 5 dimensions — image, board fit, title, description, and hashtags — in real time. With one-click AI rewrite for text fields.
        </p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href={cwsLink} class="inline-flex items-center gap-2 bg-rose-600 text-white px-6 py-3 rounded-full font-semibold text-sm hover:bg-rose-500 transition-colors shadow-lg shadow-rose-600/25">
            Install Free — Chrome Web Store
          </a>
        </div>
        <p class="text-xs text-gray-400 mt-3">Free · 50 AI scores/month · No signup</p>
      </div>
    </div>
  </section>

  <!-- Hero Screenshot -->
  <section class="max-w-6xl mx-auto px-6 pb-16">
    <div class="rounded-2xl overflow-hidden border border-white/10 shadow-2xl shadow-black/30">
      <img src={heroImage} alt="Pinello scoring a Pinterest pin in real time" class="w-full h-auto" loading="lazy" />
    </div>
  </section>

  <!-- How it works -->
  <section class="max-w-6xl mx-auto px-6 pb-20">
    <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-8">How it works</h2>
    <div class="grid sm:grid-cols-3 gap-6 animate-in">
      <div class="flex gap-4">
        <span class="flex-shrink-0 w-8 h-8 bg-rose-600 text-white font-bold rounded-full flex items-center justify-center text-sm">1</span>
        <div>
          <h3 class="font-semibold text-white">Open Pinterest pin creator</h3>
          <p class="text-sm text-gray-400 mt-1">Navigate to pinterest.com and start creating a pin. Pinello's scoring panel appears automatically.</p>
        </div>
      </div>
      <div class="flex gap-4">
        <span class="flex-shrink-0 w-8 h-8 bg-rose-600 text-white font-bold rounded-full flex items-center justify-center text-sm">2</span>
        <div>
          <h3 class="font-semibold text-white">See 5 dimension scores</h3>
          <p class="text-sm text-gray-400 mt-1">Image, board fit, title, description, and hashtags — all scored live as you fill in your pin.</p>
        </div>
      </div>
      <div class="flex gap-4">
        <span class="flex-shrink-0 w-8 h-8 bg-rose-600 text-white font-bold rounded-full flex items-center justify-center text-sm">3</span>
        <div>
          <h3 class="font-semibold text-white">Optimize with AI rewrite</h3>
          <p class="text-sm text-gray-400 mt-1">Weak title or description? Click for an AI-optimized alternative. Copy to clipboard — you paste where you want.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="bg-surface-900 border-t border-white/5">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-8">5 Dimensions Scored</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-4 animate-in">
        <FeatureCard icon="🖼️" title="Image" description="Aspect ratio, resolution, brightness, contrast — analyzed locally in your browser." />
        <FeatureCard icon="📌" title="Board Fit" description="Keyword relevance between your pin content and selected board." />
        <FeatureCard icon="✏️" title="Title SEO" description="Length, keyword placement, action words, coherence check." />
        <FeatureCard icon="📝" title="Description" description="Length optimization, CTA detection, readability scoring." />
        <FeatureCard icon="#️⃣" title="Hashtags" description="Tag count balance (2-8 ideal), inline + tagged topics combined." />
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="max-w-6xl mx-auto px-6 py-20">
    <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-8">Frequently asked questions</h2>
    <div class="max-w-2xl">
      <FaqItem question="Is Pinello free?" answer="Yes. 50 AI scores per month, no signup, no credit card. Structural scoring (image analysis, hashtag counting, keyword overlap) is always unlimited." />
      <FaqItem question="What data does Pinello collect?" answer="Only anonymous device ID for rate limiting. Title/description text sent to Azure OpenAI for AI features is processed ephemerally — never stored. Image analysis is 100% local in your browser." />
      <FaqItem question="Does Pinello modify my pins?" answer="Never. AI rewrite suggestions are copy-to-clipboard only. You paste what you want. Pinello never auto-edits your pin content." />
      <FaqItem question="Does it work on all Pinterest domains?" answer="Yes. Works on pinterest.com and all country variants (ca.pinterest.com, uk.pinterest.com, etc.) for personal, business, and creator accounts." />
      <FaqItem question="How is Pinello different from Tailwind?" answer="Tailwind is a scheduling tool. Pinello scores your pin quality BEFORE you publish — image, board fit, title, description, and hashtags rated in real time inside the pin-creation modal." />
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-white/5 bg-surface-800">
    <div class="max-w-6xl mx-auto px-6 py-16 text-center">
      <h2 class="text-2xl sm:text-3xl font-bold text-white">Score your next pin.</h2>
      <p class="text-gray-400 mt-3 text-lg">Free to install. Works instantly on Pinterest. No signup needed.</p>
      <a href={cwsLink} class="inline-flex items-center gap-2 bg-rose-600 text-white px-8 py-3 rounded-full font-semibold text-sm mt-8 hover:bg-rose-500 transition-colors shadow-lg shadow-rose-600/25">
        Install Free — Chrome Web Store
      </a>
    </div>
  </section>

  <!-- Legal -->
  <div class="max-w-6xl mx-auto px-6 py-8 flex gap-6 text-xs text-gray-500">
    <a href="/pinello/privacy" class="hover:text-gray-400">Privacy Policy</a>
    <a href="/pinello/terms" class="hover:text-gray-400">Terms of Service</a>
    <a href="/" class="hover:text-gray-400">← Back to Amrita Labs</a>
  </div>
</Base>
