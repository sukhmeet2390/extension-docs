---
import Base from '../../layouts/Base.astro';
import WhatIsBlock from '../../components/WhatIsBlock.astro';
import RelatedContentBlock from '../../components/RelatedContentBlock.astro';
import FaqItem from '../../components/FaqItem.astro';

const cwsLink = 'https://chromewebstore.google.com/detail/pinello-%E2%80%94-pinterest-pin-s/kmelegdnljikegoemigfgnpcbllmkije';
const heroImage = '/assets/screenshots/pinello/hero.png';
const iconPath = '/assets/icons/pinello.png';

const heroTitle = 'Prepare stronger Pinterest Pins before you publish.';
const heroSubtitle =
  'Pinello shows what to fix first, helps you improve the copy, and checks whether your Pin matches the board you chose — without leaving Pinterest.';

const surfaces = [
  {
    step: '1. Browse',
    name: 'Feed Score',
    body: 'Fast quality signal from visible Pin cues while you scroll — image ratio, engagement, and any title on the card.',
  },
  {
    step: '2. Inspect',
    name: 'Pin Detail Score',
    body: 'Uses fuller detail-page signals — the full title, description, board, saves, and dimensions Pinterest exposes when you open a Pin.',
  },
  {
    step: '3. Improve',
    name: 'Pin Doctor',
    body: 'Your pre-publish check inside the Create Pin workflow — reviews image, title, description, topics, and Board Match.',
  },
];

const features = [
  {
    icon: '🏷️',
    title: 'Feed Score badges',
    tier: 'FREE',
    description: 'A quick quality signal on every Pin card in your feed. Colour-coded so weak drafts and stale layouts are easy to spot.',
  },
  {
    icon: '📌',
    title: 'Pin Detail Score & stats',
    tier: 'FREE',
    description: 'Open a Pin to see saves, engagement per day, board, and a refreshed score based on the fuller detail-page data.',
  },
  {
    icon: '🩺',
    title: 'Pin Doctor',
    tier: 'FREE',
    meta: '20 checks/month',
    description: 'A pre-publish check inside Create Pin. Local scoring across image, title, description, topics, and board match.',
  },
  {
    icon: '🚫',
    title: 'Hide Ads',
    tier: 'FREE',
    description: 'Hide promoted and sponsored Pins on the Pinterest feed while you research.',
  },
  {
    icon: '✍️',
    title: 'AI actions',
    tier: 'FREE',
    meta: '5/month',
    description: 'Strengthen title, improve description, refine topics, Check board match. Copy-only — Pinello never types into Pinterest.',
  },
  {
    icon: '🔎',
    title: 'Feed sorting & Hide AI Pins',
    tier: 'PRO',
    description: 'Reorder the feed by your locally computed Pin scores and hide Pins Pinterest marks as AI-made.',
  },
  {
    icon: '📤',
    title: 'CSV export',
    tier: 'PRO',
    description: 'Export scored Pin data for audits, content planning, or handoffs to a virtual assistant.',
  },
];

const pricingTiers = [
  {
    name: 'Free',
    price: '$0',
    subtitle: 'Start here. No account. No credit card.',
    cta: 'Install Free',
    featured: false,
    href: cwsLink,
    items: [
      'Feed Score on every Pin card',
      'Pin Detail Score and Pin stats',
      '20 Pin Doctor checks per month',
      '5 AI actions per month (suggestions + Board Match)',
      'Hide Ads on the feed',
    ],
  },
  {
    name: 'Pro',
    price: '$8.99',
    priceUnit: '/month',
    kicker: 'or $79/year (save ~27%)',
    subtitle: 'For creators who want to publish stronger drafts every day.',
    cta: 'Start 7-day free trial',
    featured: true,
    href: cwsLink,
    items: [
      'More AI actions — Strengthen title, Improve description, Refine topics, Check board match',
      'Feed sorting and Hide AI Pins',
      'CSV export of scored Pins',
      'Priority support at hello@amrita-labs.com',
    ],
  },
];

const steps = [
  {
    title: 'Install',
    description: 'Add Pinello from the Chrome Web Store. Open Pinterest and start browsing like usual.',
  },
  {
    title: 'See the Feed Score',
    description: 'Every Pin card gets a quality signal. Click any badge to see the score breakdown in the side panel.',
  },
  {
    title: 'Improve inside Create Pin',
    description: 'When you draft a Pin, the Pin Doctor opens alongside the Create form and tells you what to fix first.',
  },
];

const faqs = [
  {
    question: 'What does the Feed Score on a Pin card mean?',
    answer: 'It is a quick quality signal from the visible cues Pinterest exposes on the feed — image ratio, engagement, and any title text on the card. It is not a prediction of clicks or reach.',
  },
  {
    question: 'Why does the Pin Detail Score differ from the Feed Score?',
    answer: 'The Pin closeup exposes fuller data — full title, description, board name, save count, dimensions — so Pinello recomputes the score with more signal. Both numbers are honest for the data they had access to.',
  },
  {
    question: 'What is the Pin Doctor?',
    answer: 'A pre-publish check inside the Create Pin workflow. It reviews image format, title, description, topics, and how well your Pin matches the board you selected. Structural scoring is local; AI suggestions and Board Match run only when you click the button.',
  },
  {
    question: 'Will Pinello guarantee I get more saves, clicks, or reach?',
    answer: 'No. Pinello does not guarantee saves, clicks, reach, or ranking on Pinterest. It helps you prepare stronger drafts — what Pinterest does with them is outside our control.',
  },
  {
    question: 'What does Pro cost?',
    answer: '$8.99 per month or $79 per year, with a 7-day free trial. There is no lifetime plan. Cancel any time through the checkout portal.',
  },
  {
    question: 'What data does Pinello send to servers?',
    answer: 'Nothing while you browse. Only when you explicitly click a suggestion or Board Match does the extension send the relevant draft text (title, description, board name) to our Azure backend for a single AI call. Pin images are analysed locally in your browser and never uploaded.',
  },
  {
    question: 'Do you store my Pin content?',
    answer: 'Locally, yes — recent scores are cached so the side panel and CSV export work; the score history is cleared on browser restart. Server-side, we cache AI-generated alternatives for 24 hours and Board Match similarity for 30 days so repeated requests do not double-charge you.',
  },
  {
    question: 'Do you offer refunds?',
    answer: 'Refund requests are handled case-by-case at Amrita Labs\u2019 discretion. Email hello@amrita-labs.com.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'Pinello',
      description:
        'Pinello is a pre-publish quality check for Pinterest creators. It surfaces Feed Score and Pin Detail Score as you browse, and opens the Pin Doctor inside Create Pin to review image, title, description, topics, and board match before you publish.',
      applicationCategory: 'BrowserExtension',
      applicationSubCategory: 'Pinterest creator tool',
      operatingSystem: 'Chrome',
      image: iconPath,
      screenshot: heroImage,
      featureList: features.map((feature) => `${feature.title} (${feature.tier}${feature.meta ? `, ${feature.meta}` : ''})`),
      offers: [
        {
          '@type': 'Offer',
          name: 'Free',
          price: '0',
          priceCurrency: 'USD',
          description: 'Feed Score badges, Pin Detail Score and stats, 20 Pin Doctor checks per month, 5 AI actions per month (suggestions + Board Match), Hide Ads.',
        },
        {
          '@type': 'Offer',
          name: 'Pro (monthly)',
          price: '8.99',
          priceCurrency: 'USD',
          billingDuration: 'P1M',
          description: 'More AI actions, feed sorting, Hide AI Pins, CSV export. 7-day free trial.',
        },
        {
          '@type': 'Offer',
          name: 'Pro (annual)',
          price: '79',
          priceCurrency: 'USD',
          billingDuration: 'P1Y',
          description: 'All Pro features on annual billing. 7-day free trial.',
        },
      ],
      keywords: 'Pinterest pin scorer, Pinterest pin quality check, Pin Doctor, board match, Pinterest creator tool',
      url: 'https://amrita-labs.com/pinello/',
      installUrl: cwsLink,
      author: { '@type': 'Organization', name: 'Amrita Labs', url: 'https://amrita-labs.com' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
    },
  ],
};
---

<Base
  title="Pinello — Pin Doctor for Pinterest creators | Chrome extension"
  description="Prepare stronger Pinterest Pins before you publish. Pinello shows what to fix first, helps you improve the copy, and checks board match — inside Pinterest."
  canonical="https://amrita-labs.com/pinello/"
  schema={schema}
  ogImage={heroImage}
  breadcrumbs={[
    { name: 'Home', url: 'https://amrita-labs.com/' },
    { name: 'Chrome Extensions', url: 'https://amrita-labs.com/chrome-extensions/' },
    { name: 'Pinello', url: 'https://amrita-labs.com/pinello/' },
  ]}
  appendBrand={false}
>
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-emerald-400/12 via-sky-400/8 to-transparent"></div>
    <div class="absolute top-0 left-1/2 h-[420px] w-[900px] -translate-x-1/2 rounded-full bg-gradient-to-r from-emerald-400/12 via-sky-400/10 to-cyan-400/12 blur-3xl"></div>
    <div class="relative max-w-6xl mx-auto px-6 pt-24 pb-16 sm:pt-32">
      <div class="grid gap-14 lg:grid-cols-[1.05fr,0.95fr] lg:items-center">
        <div class="max-w-2xl">
          <div class="inline-flex items-center gap-3 rounded-full border border-emerald-400/20 bg-emerald-950/40 px-4 py-2">
            <img src={iconPath} alt="Pinello Chrome extension icon" class="w-8 h-8 rounded-lg" loading="eager" />
            <span class="text-xs font-semibold uppercase tracking-[0.18em] text-emerald-200">Chrome Extension</span>
          </div>
          <h1 class="mt-6 text-4xl font-extrabold leading-tight tracking-tight text-white sm:text-5xl">
            {heroTitle}
          </h1>
          <p class="mt-6 text-lg leading-relaxed text-gray-300">{heroSubtitle}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={cwsLink} class="inline-flex items-center gap-2 rounded-full bg-emerald-400 px-6 py-3 text-sm font-semibold text-surface-950 shadow-lg shadow-emerald-400/20 transition-colors hover:bg-emerald-300">
              Install on Chrome Web Store
            </a>
            <a href="#pricing" class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-6 py-3 text-sm font-semibold text-white transition-colors hover:border-emerald-300/30 hover:text-emerald-200">
              See pricing
            </a>
          </div>
          <p class="mt-3 text-xs text-gray-400">Free to start · 7-day Pro trial · Cancel any time in checkout</p>
          <div class="mt-8 inline-flex items-center gap-2 rounded-full border border-sky-400/20 bg-sky-950/40 px-4 py-2 text-sm text-sky-100">
            <span class="inline-flex h-2 w-2 rounded-full bg-emerald-300"></span>
            Copy-only AI. Pinello never types into Pinterest for you.
          </div>
        </div>

        <div class="relative mx-auto w-full max-w-xl">
          <div class="overflow-hidden rounded-[28px] border border-white/10 bg-white/5 p-3 shadow-2xl shadow-black/30 backdrop-blur">
            <div class="overflow-hidden rounded-[22px] border border-white/10 bg-white">
              <img src={heroImage} alt="Pinello showing the Feed Score, Pin Detail Score, and Pin Doctor inside Pinterest" class="w-full h-auto" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="how" class="border-y border-white/5 bg-surface-900">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <div class="max-w-2xl">
        <h2 class="text-xs font-semibold uppercase tracking-widest text-gray-400">The three surfaces</h2>
        <h3 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">Browse. Inspect. Improve.</h3>
        <p class="mt-4 text-lg leading-relaxed text-gray-400">
          Each surface uses the data actually available at that moment. That is why the Feed Score, the Pin Detail Score, and the Pin Doctor can look different — and that is a feature, not a bug.
        </p>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-3 animate-in">
        {surfaces.map((surface) => (
          <div class="rounded-2xl border border-white/5 bg-surface-800 p-6 shadow-sm shadow-black/20">
            <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-emerald-300">{surface.step}</div>
            <h4 class="mt-3 text-xl font-semibold text-white">{surface.name}</h4>
            <p class="mt-3 text-sm leading-relaxed text-gray-400">{surface.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="features" class="bg-surface-950">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <div class="max-w-2xl">
        <h2 class="text-xs font-semibold uppercase tracking-widest text-gray-400">What you get</h2>
        <h3 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">Signals while you browse. A pre-publish check when it matters.</h3>
        <p class="mt-4 text-lg leading-relaxed text-gray-400">
          Structural scoring is fully local. AI suggestions and Board Match run only when you click the button — never automatically.
        </p>
      </div>

      <div class="mt-12 grid gap-4 sm:grid-cols-2 xl:grid-cols-4 animate-in">
        {features.map((feature) => (
          <div class="rounded-2xl border border-white/5 bg-surface-800 p-6 transition-all hover:border-emerald-400/20 hover:shadow-lg hover:shadow-black/20">
            <div class="flex items-start justify-between gap-4">
              <span class="text-2xl">{feature.icon}</span>
              <div class="flex flex-wrap justify-end gap-2">
                <span class:list={[
                  'rounded-full border px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.18em]',
                  feature.tier === 'FREE' && 'border-emerald-400/20 bg-emerald-950/70 text-emerald-200',
                  feature.tier === 'PRO' && 'border-sky-400/20 bg-sky-950/70 text-sky-200',
                ]}>
                  {feature.tier}
                </span>
                {feature.meta && (
                  <span class="rounded-full border border-white/10 bg-white/5 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.16em] text-gray-300">
                    {feature.meta}
                  </span>
                )}
              </div>
            </div>
            <h4 class="mt-4 text-lg font-semibold text-white">{feature.title}</h4>
            <p class="mt-2 text-sm leading-relaxed text-gray-400">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="pricing" class="max-w-6xl mx-auto px-6 py-20">
    <div class="max-w-2xl">
      <h2 class="text-xs font-semibold uppercase tracking-widest text-gray-400">Pricing</h2>
      <h3 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">Two plans. Honest scope.</h3>
      <p class="mt-4 text-lg leading-relaxed text-gray-400">
        Use Free until it earns its keep. Upgrade to Pro when you want more AI actions per month, feed controls, and CSV export.
      </p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-2 animate-in">
      {pricingTiers.map((tier) => (
        <div class:list={[
          'rounded-3xl border bg-surface-900 p-8 shadow-sm shadow-black/20',
          tier.featured ? 'border-emerald-400/50 shadow-2xl shadow-emerald-400/10' : 'border-white/5',
        ]}>
          {tier.featured && (
            <div class="mb-5 inline-flex rounded-full bg-emerald-400 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.18em] text-surface-950">
              7-day free trial
            </div>
          )}
          <div class="text-xs font-semibold uppercase tracking-[0.18em] text-gray-400">{tier.name}</div>
          <div class="mt-4 flex items-baseline gap-2">
            <span class="text-5xl font-extrabold tracking-tight text-white">{tier.price}</span>
            {tier.priceUnit && <span class="text-sm text-gray-400">{tier.priceUnit}</span>}
          </div>
          {tier.kicker && <p class="mt-2 text-sm font-medium text-emerald-200">{tier.kicker}</p>}
          <p class="mt-3 text-sm leading-relaxed text-gray-400">{tier.subtitle}</p>
          <ul class="mt-8 space-y-3 text-sm text-gray-300">
            {tier.items.map((item) => (
              <li class="flex gap-3">
                <span class="text-emerald-300">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <a
            href={tier.href}
            class:list={[
              'mt-8 inline-flex w-full items-center justify-center rounded-full px-6 py-3 text-sm font-semibold transition-colors',
              tier.featured
                ? 'bg-emerald-400 text-surface-950 hover:bg-emerald-300'
                : 'border border-white/10 bg-white text-surface-950 hover:bg-gray-100',
            ]}
          >
            {tier.cta}
          </a>
        </div>
      ))}
    </div>

    <p class="mt-6 text-xs text-gray-500">
      Subscriptions billed via ExtensionPay / Stripe. Refunds handled case-by-case at Amrita Labs&rsquo; discretion — email <a href="mailto:hello@amrita-labs.com" class="underline hover:text-gray-300">hello@amrita-labs.com</a>. Pinello does not guarantee saves, clicks, reach, or ranking on Pinterest.
    </p>
  </section>

  <section class="border-y border-white/5 bg-surface-900">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <div class="max-w-2xl">
        <h2 class="text-xs font-semibold uppercase tracking-widest text-gray-400">How it works</h2>
        <h3 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">Three steps. That is it.</h3>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-3 animate-in">
        {steps.map((step, index) => (
          <div class="rounded-2xl border border-white/5 bg-surface-800 p-6 shadow-sm shadow-black/20">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-400 font-mono text-sm font-bold text-surface-950">
              0{index + 1}
            </div>
            <h4 class="mt-5 text-xl font-semibold text-white">{step.title}</h4>
            <p class="mt-3 text-sm leading-relaxed text-gray-400">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-20">
    <div class="rounded-3xl border border-white/5 bg-surface-800 p-8 sm:p-10 lg:flex lg:items-center lg:justify-between lg:gap-10">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-bold text-white sm:text-3xl">Prepare stronger Pins before you publish.</h2>
        <p class="mt-3 text-lg leading-relaxed text-gray-400">
          Install Pinello, keep browsing Pinterest, and let the Feed Score, Pin Detail Score, and Pin Doctor tell you what to fix first.
        </p>
      </div>
      <div class="mt-6 lg:mt-0">
        <a href={cwsLink} class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white px-6 py-3 text-sm font-semibold text-surface-950 transition-colors hover:bg-gray-100">
          Install Pinello on Chrome
        </a>
      </div>
    </div>
  </section>

  <section class="border-t border-white/5 bg-surface-900">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <div class="max-w-2xl">
        <h2 class="text-xs font-semibold uppercase tracking-widest text-gray-400">Frequently asked questions</h2>
        <h3 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">Clear answers, on the record.</h3>
      </div>

      <div class="mt-8 max-w-3xl">
        {faqs.map((faq) => (
          <FaqItem question={faq.question} answer={faq.answer} />
        ))}
      </div>
    </div>
  </section>

  <WhatIsBlock
    productName="Pinello"
    definition="Pinello is a Chrome extension that helps Pinterest creators prepare stronger Pins before publishing. It surfaces a Feed Score on Pin cards, a Pin Detail Score inside the closeup, and a Pin Doctor pre-publish check inside Create Pin. Structural scoring runs locally in the browser; AI suggestions and Board Match run only when the creator clicks a button. Pinello never types into Pinterest for you and does not guarantee saves, clicks, reach, or ranking."
  />
  <RelatedContentBlock productSlug="pinello" theme="dark" />

  <div class="max-w-6xl mx-auto px-6 py-8 flex flex-wrap gap-6 text-xs text-gray-500">
    <a href="/pinello/privacy/" class="hover:text-gray-400">Privacy Policy</a>
    <a href="/pinello/terms/" class="hover:text-gray-400">Terms of Service</a>
    <a href={cwsLink} class="hover:text-gray-400">Chrome Web Store</a>
    <a href="mailto:hello@amrita-labs.com" class="hover:text-gray-400">hello@amrita-labs.com</a>
    <a href="/" class="hover:text-gray-400">&larr; Back to Amrita Labs</a>
  </div>
</Base>
