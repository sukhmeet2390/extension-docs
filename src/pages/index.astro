---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Amrita Labs",
  "url": "https://amrita-labs.com",
  "description": "Productivity tools for email marketers, Pinterest creators, and Shopify merchants.",
  "foundingDate": "2026",
  "contactPoint": {
    "@type": "ContactPoint",
    "email": "hello@amrita-labs.com",
    "contactType": "customer support"
  }
};
---

<Base
  title="Amrita Labs"
  description="Productivity tools for email marketers, Pinterest creators, and Shopify merchants. Privacy-first. Free to start."
  canonical="https://amrita-labs.com"
  schema={schema}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-brand-600/5 via-transparent to-transparent"></div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-brand-600/8 rounded-full blur-[120px]"></div>
    <div class="max-w-6xl mx-auto px-6 pt-24 pb-8 sm:pt-36 sm:pb-12 relative">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 text-xs font-medium text-gray-400 bg-white/5 px-3 py-1.5 rounded-full border border-white/10 mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-green-400 animate-pulse"></span>
          Privacy-first · Free to start
        </div>
        <h1 class="text-4xl sm:text-6xl font-extrabold text-white leading-[1.05] tracking-tight">
          Publish with<br />confidence,<br />
          <span class="text-brand-400">every time.</span>
        </h1>
        <p class="text-lg text-gray-400 mt-6 leading-relaxed max-w-lg">
          Chrome extensions and Shopify apps that score your content in real time — so you know it's ready before you hit send.
        </p>
        <a href="#products" class="inline-flex items-center gap-2 text-sm font-semibold text-brand-400 mt-8 hover:text-brand-300 transition-colors">
          See all products ↓
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Products (Chrome Extensions) -->
  <section id="products" class="bg-surface-900">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <div class="flex items-center gap-3 mb-6">
        <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest">Chrome Extensions</h2>
        <div class="flex-1 h-px bg-white/5"></div>
      </div>
    <div class="grid sm:grid-cols-2 gap-5 animate-in">
      <ProductCard
        name="EmailSubjectScore Pro"
        tagline="Score your subject line before you send"
        description="Spam risk, clarity, and urgency — rated live inside Gmail compose. AI-powered rewrite suggestions when your score is weak."
        iconSrc="/assets/icons/gmail.png"
        screenshotSrc="/assets/screenshots/gmail/hero.png"
        href="/gmail-subject-score/"
        cta="Learn more"
        ctaHref="/gmail-subject-score/"
        platform="chrome"
        featured={true}
      />
      <ProductCard
        name="Pinello"
        tagline="Score every pin before you publish"
        description="5 dimensions scored in real time — image, board fit, title, description, and hashtags. With one-click AI rewrite for text fields."
        iconSrc="/assets/icons/pinello.png"
        screenshotSrc="/assets/screenshots/pinello/hero.png"
        href="/pinello/"
        cta="Learn more"
        ctaHref="/pinello/"
        platform="chrome"
        featured={true}
      />
    </div>
    </div>
  </section>

  <!-- Shopify Apps -->
  <section class="max-w-6xl mx-auto px-6 py-20">
    <div class="flex items-center gap-3 mb-6">
      <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest">Shopify Apps</h2>
      <div class="flex-1 h-px bg-white/5"></div>
    </div>
    <div class="grid sm:grid-cols-3 gap-4 animate-in">
      <ProductCard
        name="Cookie Consent"
        tagline="GDPR & Consent Mode v2"
        description="Cookie consent banner with Google Consent Mode v2 built in. Auto-detects visitor region and adapts to GDPR, CCPA requirements."
        iconSrc="/assets/icons/cookie.png"
        screenshotSrc="/assets/screenshots/cookie/hero.png"
        href="/cookie-consent/"
        cta="Learn more"
        ctaHref="/cookie-consent/"
        platform="shopify"
      />
      <ProductCard
        name="Accessibility Widget"
        tagline="WCAG accessibility toolbar"
        description="One-click accessibility toolbar for Shopify stores. Font scaling, contrast modes, reading guide, and more."
        iconSrc="/assets/icons/accessibility.png"
        screenshotSrc="/assets/screenshots/accessibility/hero.png"
        href="/accessibility-widget/"
        cta="Learn more"
        ctaHref="/accessibility-widget/"
        platform="shopify"
      />
      <ProductCard
        name="Chat Widget"
        tagline="Multi-channel chat button"
        description="WhatsApp, Messenger, Email, and Phone — all in one floating chat button for Shopify stores."
        iconSrc="/assets/icons/chat.png"
        screenshotSrc="/assets/screenshots/chat/hero.png"
        href="/chat-widget/"
        cta="Learn more"
        ctaHref="/chat-widget/"
        platform="shopify"
      />
    </div>
  </section>

  <!-- About -->
  <section class="bg-surface-800 border-t border-white/5">
    <div class="max-w-6xl mx-auto px-6 py-16 sm:py-24">
      <div class="max-w-xl">
        <h2 class="text-2xl font-bold text-white">Built for real users.</h2>
        <p class="text-gray-400 mt-4 leading-relaxed">
          Amrita Labs builds productivity tools for creators and merchants. Every tool solves a real problem —
          no bloat, no invasive tracking, and always free to start.
        </p>
        <p class="text-gray-400 mt-3 leading-relaxed">
          Questions or feedback?
          <a href="mailto:hello@amrita-labs.com" class="text-brand-400 hover:text-brand-300 transition-colors">hello@amrita-labs.com</a>
        </p>
      </div>
    </div>
  </section>
</Base>
