---
import Base from '../../layouts/Base.astro';

const cwsLink = 'https://chromewebstore.google.com/detail/privacy-blur-for-whatsapp/akficmlcinjihflahiekkkheikceblfc';
const heroImage = '/assets/screenshots/privacy-blur-whatsapp/hero.png';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "Privacy Blur for WhatsApp",
      "description": "Chrome extension that blurs private WhatsApp messages, contact names, previews, and media during screen sharing or recordings. Hover to reveal only for your eyes.",
      "applicationCategory": "BrowserExtension",
      "operatingSystem": "Chrome",
      "offers": [
        { "@type": "Offer", "price": "0", "priceCurrency": "USD", "description": "Free tier with core blur zones and hover-to-reveal" },
        { "@type": "Offer", "price": "5", "priceCurrency": "USD", "description": "Pro lifetime after a 7-day trial — persistence, shortcuts, keyword rules, and sender rules" }
      ],
      "url": "https://amrita-labs.com/privacy-blur-whatsapp/",
      "installUrl": cwsLink,
      "author": { "@type": "Organization", "name": "Amrita Labs", "url": "https://amrita-labs.com" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "Is Privacy Blur for WhatsApp free?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Core blur zones and hover-to-reveal are free forever. Pro adds persistence, keyboard shortcuts, keyword rules, and sender rules for $5 one-time (lifetime)." }},
        { "@type": "Question", "name": "Does it send my chats to a server?", "acceptedAnswer": { "@type": "Answer", "text": "No WhatsApp chat content, contact names, or media are sent to Amrita Labs. Blur logic runs locally in your browser. Anonymous product analytics and billing events are covered in the privacy policy." }},
        { "@type": "Question", "name": "Does it work in group chats and DMs?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. It works on WhatsApp Web across direct messages, group chats, the chat sidebar, previews, and shared media." }},
        { "@type": "Question", "name": "Can I blur the chat list before I start sharing?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. You can independently blur chat list names, preview text, profile photos, the active conversation, compose box, media, and status text." }},
        { "@type": "Question", "name": "Does it work in the WhatsApp desktop app?", "acceptedAnswer": { "@type": "Answer", "text": "Privacy Blur works on WhatsApp Web at web.whatsapp.com in Chrome. The desktop app does not support Chrome extensions." }}
      ]
    }
  ]
};
---

<Base
  title="Privacy Blur for WhatsApp — Hide Chats During Screen Sharing"
  description="Chrome extension that blurs private WhatsApp messages, contact names, previews, and media during screen sharing or recordings. Hover to reveal only for your eyes."
  canonical="https://amrita-labs.com/privacy-blur-whatsapp/"
  schema={schema}
  ogImage={heroImage}
  breadcrumbs={[
    { name: 'Home', url: 'https://amrita-labs.com/' },
    { name: 'Chrome Extensions', url: 'https://amrita-labs.com/chrome-extensions/' },
    { name: 'Privacy Blur for WhatsApp', url: 'https://amrita-labs.com/privacy-blur-whatsapp/' },
  ]}
>
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-[#25D366]/10 via-transparent to-transparent"></div>
    <div class="max-w-6xl mx-auto px-6 pt-24 pb-16 sm:pt-32 relative">
      <div class="max-w-2xl">
        <span class="inline-block text-xs font-semibold text-[#25D366] bg-[#0f2418]/80 px-3 py-1.5 rounded-full border border-[#25D366]/20 uppercase tracking-wider">Chrome Extension</span>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-white mt-6 leading-tight tracking-tight">
          Share your screen,<br />not your private chats.
        </h1>
        <p class="text-lg text-gray-400 mt-6 leading-relaxed">
          Privacy Blur for WhatsApp hides sensitive chats, names, previews, and media on WhatsApp Web during screen sharing, recordings, and live demos. Blur what's public. Hover to reveal what's personal.
        </p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href={cwsLink} class="inline-flex items-center gap-2 bg-[#25D366] text-[#08120d] px-6 py-3 rounded-full font-semibold text-sm hover:bg-[#48db7d] transition-colors shadow-lg shadow-[#25D366]/25">
            View on Chrome Web Store
          </a>
        </div>
        <p class="text-xs text-gray-400 mt-3">Free forever · Pro from $5 lifetime · 7-day trial</p>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 pb-16">
    <div class="rounded-2xl overflow-hidden border border-white/10 shadow-2xl shadow-black/30">
      <img src={heroImage} alt="Privacy Blur for WhatsApp hiding chats during screen sharing" class="w-full h-auto" loading="lazy" />
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 pb-20">
    <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-8">How it works</h2>
    <div class="grid sm:grid-cols-3 gap-6 animate-in">
      <div class="flex gap-4">
        <span class="flex-shrink-0 w-8 h-8 bg-[#25D366] text-[#08120d] font-bold rounded-full flex items-center justify-center text-sm">1</span>
        <div>
          <h3 class="font-semibold text-white">Open WhatsApp Web</h3>
          <p class="text-sm text-gray-400 mt-1">Navigate to web.whatsapp.com in Chrome. The Privacy Blur widget appears automatically in the bottom-right corner.</p>
        </div>
      </div>
      <div class="flex gap-4">
        <span class="flex-shrink-0 w-8 h-8 bg-[#25D366] text-[#08120d] font-bold rounded-full flex items-center justify-center text-sm">2</span>
        <div>
          <h3 class="font-semibold text-white">Choose what stays private</h3>
          <p class="text-sm text-gray-400 mt-1">Toggle messages, contact names, chat previews, media, the compose box, and more before you start sharing.</p>
        </div>
      </div>
      <div class="flex gap-4">
        <span class="flex-shrink-0 w-8 h-8 bg-[#25D366] text-[#08120d] font-bold rounded-full flex items-center justify-center text-sm">3</span>
        <div>
          <h3 class="font-semibold text-white">Hover to reveal</h3>
          <p class="text-sm text-gray-400 mt-1">Need to read something yourself? Hover over a blurred area to peek locally while your audience still sees the blur.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-900 border-t border-white/5">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-8">8 Independent Blur Zones</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 animate-in">
        <div class="bg-surface-800 border border-white/5 rounded-xl p-5 hover:border-[#25D366]/20 hover:shadow-sm transition-all"><span class="text-2xl">💬</span><h3 class="text-base font-semibold text-white mt-3">Messages</h3><p class="text-sm text-gray-400 mt-2 leading-relaxed">Blur message text inside the active conversation and threads.</p></div>
        <div class="bg-surface-800 border border-white/5 rounded-xl p-5 hover:border-[#25D366]/20 hover:shadow-sm transition-all"><span class="text-2xl">👤</span><h3 class="text-base font-semibold text-white mt-3">Contact Names</h3><p class="text-sm text-gray-400 mt-2 leading-relaxed">Hide the current chat title and sender names in busy group chats.</p></div>
        <div class="bg-surface-800 border border-white/5 rounded-xl p-5 hover:border-[#25D366]/20 hover:shadow-sm transition-all"><span class="text-2xl">📋</span><h3 class="text-base font-semibold text-white mt-3">Chat List</h3><p class="text-sm text-gray-400 mt-2 leading-relaxed">Blur names in the left sidebar so nobody sees who you talk to.</p></div>
        <div class="bg-surface-800 border border-white/5 rounded-xl p-5 hover:border-[#25D366]/20 hover:shadow-sm transition-all"><span class="text-2xl">👁️</span><h3 class="text-base font-semibold text-white mt-3">Preview Text</h3><p class="text-sm text-gray-400 mt-2 leading-relaxed">Hide chat preview snippets before you start screen sharing.</p></div>
        <div class="bg-surface-800 border border-white/5 rounded-xl p-5 hover:border-[#25D366]/20 hover:shadow-sm transition-all"><span class="text-2xl">🖼️</span><h3 class="text-base font-semibold text-white mt-3">Profile Photos</h3><p class="text-sm text-gray-400 mt-2 leading-relaxed">Blur avatars in the sidebar, header, and chat info drawer.</p></div>
        <div class="bg-surface-800 border border-white/5 rounded-xl p-5 hover:border-[#25D366]/20 hover:shadow-sm transition-all"><span class="text-2xl">✏️</span><h3 class="text-base font-semibold text-white mt-3">Compose Box</h3><p class="text-sm text-gray-400 mt-2 leading-relaxed">Hide drafts, replies, and half-written messages before they leak.</p></div>
        <div class="bg-surface-800 border border-white/5 rounded-xl p-5 hover:border-[#25D366]/20 hover:shadow-sm transition-all"><span class="text-2xl">📎</span><h3 class="text-base font-semibold text-white mt-3">Images &amp; Videos</h3><p class="text-sm text-gray-400 mt-2 leading-relaxed">Blur shared photos, videos, and media thumbnails in the chat.</p></div>
        <div class="bg-surface-800 border border-white/5 rounded-xl p-5 hover:border-[#25D366]/20 hover:shadow-sm transition-all"><span class="text-2xl">🕐</span><h3 class="text-base font-semibold text-white mt-3">Status / About</h3><p class="text-sm text-gray-400 mt-2 leading-relaxed">Hide status text and about info when contact details are visible.</p></div>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-20">
    <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-8">Pro Features</h2>
    <div class="max-w-2xl">
      <ul class="space-y-4 text-gray-300">
        <li class="flex gap-3"><span class="text-[#25D366]">✓</span> Persist blur settings across page reloads</li>
        <li class="flex gap-3"><span class="text-[#25D366]">✓</span> Alt+Shift+B global toggle and Alt+Shift+1 through 8 per-zone shortcuts</li>
        <li class="flex gap-3"><span class="text-[#25D366]">✓</span> Custom keyword rules — auto-blur terms like "salary", "offer", or "confidential"</li>
        <li class="flex gap-3"><span class="text-[#25D366]">✓</span> Sender rules — automatically blur every message from specific people</li>
        <li class="flex gap-3"><span class="text-[#25D366]">✓</span> One payment, lifetime access — no recurring fees</li>
        <li class="flex gap-3"><span class="text-[#25D366]">✓</span> Priority email support</li>
      </ul>
      <p class="text-sm text-gray-500 mt-6">7-day free trial · $5 one-time (lifetime) · Cancel anytime</p>
    </div>
  </section>

  <section class="border-t border-white/5 bg-surface-900">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-8">Frequently asked questions</h2>
      <div class="max-w-2xl">
        <details class="group border-b border-white/5 last:border-0"><summary class="flex items-center justify-between py-4 cursor-pointer text-white font-medium hover:text-[#25D366] transition-colors"><span>Is Privacy Blur for WhatsApp free?</span><svg class="w-5 h-5 text-gray-500 group-open:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg></summary><div class="pb-4 text-gray-400 leading-relaxed text-sm">Yes. Core blur zones and hover-to-reveal are free forever. Pro adds persistence, keyboard shortcuts, keyword rules, and sender rules for $5 one-time (lifetime).</div></details>
        <details class="group border-b border-white/5 last:border-0"><summary class="flex items-center justify-between py-4 cursor-pointer text-white font-medium hover:text-[#25D366] transition-colors"><span>Does it send my chats to a server?</span><svg class="w-5 h-5 text-gray-500 group-open:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg></summary><div class="pb-4 text-gray-400 leading-relaxed text-sm">No WhatsApp chat content, contact names, or media are sent to Amrita Labs. Blur logic runs locally in your browser. Anonymous product analytics and billing events are covered in the privacy policy.</div></details>
        <details class="group border-b border-white/5 last:border-0"><summary class="flex items-center justify-between py-4 cursor-pointer text-white font-medium hover:text-[#25D366] transition-colors"><span>Does it work in group chats and DMs?</span><svg class="w-5 h-5 text-gray-500 group-open:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg></summary><div class="pb-4 text-gray-400 leading-relaxed text-sm">Yes. It works on WhatsApp Web across direct messages, group chats, the chat sidebar, previews, and shared media.</div></details>
        <details class="group border-b border-white/5 last:border-0"><summary class="flex items-center justify-between py-4 cursor-pointer text-white font-medium hover:text-[#25D366] transition-colors"><span>Can I blur the chat list before I start sharing?</span><svg class="w-5 h-5 text-gray-500 group-open:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg></summary><div class="pb-4 text-gray-400 leading-relaxed text-sm">Yes. You can independently blur chat list names, preview text, profile photos, the active conversation, compose box, media, and status text.</div></details>
        <details class="group border-b border-white/5 last:border-0"><summary class="flex items-center justify-between py-4 cursor-pointer text-white font-medium hover:text-[#25D366] transition-colors"><span>Does it work in the WhatsApp desktop app?</span><svg class="w-5 h-5 text-gray-500 group-open:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg></summary><div class="pb-4 text-gray-400 leading-relaxed text-sm">Privacy Blur works on WhatsApp Web at web.whatsapp.com in Chrome. The desktop app does not support Chrome extensions.</div></details>
      </div>
    </div>
  </section>

  <section class="border-t border-white/5 bg-surface-800">
    <div class="max-w-6xl mx-auto px-6 py-16 text-center">
      <h2 class="text-2xl sm:text-3xl font-bold text-white">Screen share without second-guessing.</h2>
      <p class="text-gray-400 mt-3 text-lg">Blur fast. Share calmly. Keep private chats private.</p>
      <a href={cwsLink} class="inline-flex items-center gap-2 bg-[#25D366] text-[#08120d] px-8 py-3 rounded-full font-semibold text-sm mt-8 hover:bg-[#48db7d] transition-colors shadow-lg shadow-[#25D366]/25">
        View on Chrome Web Store
      </a>
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-6 py-8 flex gap-6 text-xs text-gray-500">
    <a href="/privacy-blur-whatsapp/privacy" class="hover:text-gray-400">Privacy Policy</a>
    <a href="/privacy-blur-whatsapp/terms/" class="hover:text-gray-400">Terms of Service</a>
    <a href="mailto:hello@amrita-labs.com" class="hover:text-gray-400">hello@amrita-labs.com</a>
    <a href="/" class="hover:text-gray-400">← Back to Amrita Labs</a>
  </div>
</Base>
