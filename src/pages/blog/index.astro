---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<Base
  title="Blog — Amrita Labs"
  description="Articles about Chrome extensions, Shopify apps, cold email, Pinterest SEO, and building indie products."
  canonical="https://amrita-labs.com/blog/"
  theme="light"
>
  <section class="max-w-6xl mx-auto px-6 pt-24 pb-16 sm:pt-32">
    <div class="max-w-2xl">
      <h1 class="text-4xl font-extrabold text-gray-900 tracking-tight">Blog</h1>
      <p class="text-gray-500 mt-4 leading-relaxed">Articles about building Chrome extensions, Shopify apps, and growing an indie product business.</p>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 pb-24">
    {posts.length === 0 && (
      <p class="text-gray-400">Coming soon.</p>
    )}
    <div class="space-y-6">
      {posts.map((post) => (
        <a href={`/blog/${post.id}/`} class="group block bg-gray-50 border border-gray-200 rounded-xl p-6 hover:border-brand-500/40 hover:shadow-lg transition-all duration-300">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h2 class="text-lg font-bold text-gray-900 group-hover:text-brand-600 transition-colors">{post.data.title}</h2>
              <p class="text-sm text-gray-500 mt-2 leading-relaxed">{post.data.description}</p>
              {post.data.tags && (
                <div class="flex gap-2 mt-3 flex-wrap">
                  {post.data.tags.map((tag: string) => (
                    <span class="text-xs text-gray-500 bg-gray-100 px-2 py-0.5 rounded-full">#{tag}</span>
                  ))}
                </div>
              )}
            </div>
            <span class="text-xs text-gray-400 whitespace-nowrap mt-1">{post.data.date}</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>
