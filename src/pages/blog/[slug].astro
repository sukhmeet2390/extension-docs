---
import Base from '../../layouts/Base.astro';
import ProductFooter from '../../components/ProductFooter.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.data.title,
  "description": post.data.description,
  "datePublished": post.data.date,
  ...(post.data.image && { "image": post.data.image.startsWith('http') ? post.data.image : `https://amrita-labs.com${post.data.image}` }),
  "author": { "@type": "Organization", "name": "Amrita Labs", "url": "https://amrita-labs.com" },
  "publisher": { "@type": "Organization", "name": "Amrita Labs", "url": "https://amrita-labs.com" }
};
---

<Base
  title={post.data.title}
  description={post.data.description}
  canonical={post.data.canonical || `https://amrita-labs.com/blog/${post.id}/`}
  schema={schema}
  ogImage={post.data.image}
  theme="light"
>
  <article class="max-w-3xl mx-auto px-6 pt-24 pb-16 sm:pt-32">
    <!-- Header -->
    <div class="mb-12">
      <a href="/blog/" class="text-sm text-gray-400 hover:text-brand-600 transition-colors">← Back to blog</a>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 mt-4 leading-tight tracking-tight">{post.data.title}</h1>
      <div class="flex items-center gap-4 mt-4">
        <span class="text-sm text-gray-400">{post.data.date}</span>
        {post.data.tags && (
          <div class="flex gap-2 flex-wrap">
            {post.data.tags.map((tag: string) => (
              <span class="text-xs text-gray-500 bg-gray-100 px-2 py-0.5 rounded-full">#{tag}</span>
            ))}
          </div>
        )}
      </div>
    </div>

    <!-- Article content (rendered from markdown) -->
    <div class="prose prose-gray max-w-none
      prose-headings:text-gray-900 prose-headings:font-bold prose-headings:tracking-tight
      prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4
      prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
      prose-p:text-gray-700 prose-p:leading-relaxed
      prose-a:text-brand-600 prose-a:no-underline hover:prose-a:underline
      prose-strong:text-gray-900
      prose-code:text-brand-700 prose-code:bg-gray-100 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded
      prose-pre:bg-gray-50 prose-pre:border prose-pre:border-gray-200
      prose-li:text-gray-700
      prose-blockquote:border-brand-500 prose-blockquote:text-gray-500
      prose-hr:border-gray-200
      prose-img:rounded-xl prose-img:border prose-img:border-gray-200 prose-img:shadow-sm">
      <Content />
    </div>

    <!-- Product mentions: in DOM for GEO, visually subtle -->
    <ProductFooter visible={false} />
  </article>

  <!-- Subtle site footer (not promotional) -->
  <section class="border-t border-gray-200 bg-gray-50">
    <div class="max-w-3xl mx-auto px-6 py-12 text-center">
      <p class="text-sm text-gray-400">More from <a href="/" class="text-gray-500 hover:text-brand-600">Amrita Labs</a></p>
    </div>
  </section>
</Base>
