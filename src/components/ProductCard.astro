---
interface Props {
  name: string;
  tagline: string;
  description: string;
  iconSrc: string;
  href: string;
  cta: string;
  ctaHref: string;
  platform: 'chrome' | 'shopify';
  screenshotSrc?: string;
  featured?: boolean;
}

const { name, tagline, description, iconSrc, href, cta, ctaHref, platform, screenshotSrc, featured = false } = Astro.props;
const platformBadge = platform === 'chrome' ? 'Chrome Extension' : 'Shopify App';
---

<a href={href} class:list={[
  "group block rounded-2xl border transition-all duration-300 hover:-translate-y-1 overflow-hidden",
  featured
    ? "bg-surface-800 border-white/10 hover:border-brand-500/40 hover:shadow-xl hover:shadow-brand-500/5"
    : "bg-surface-800 border-white/5 hover:border-white/15 hover:shadow-lg hover:shadow-white/5"
]}>
  {screenshotSrc && (
    <div class="relative overflow-hidden bg-surface-700">
      <img src={screenshotSrc} alt={`${name} screenshot`} class="w-full h-auto opacity-90 group-hover:opacity-100 group-hover:scale-[1.02] transition-all duration-500" loading="lazy" />
      <div class="absolute inset-0 bg-gradient-to-t from-surface-800 via-transparent to-transparent"></div>
    </div>
  )}
  <div class="p-6">
    <div class="flex items-start gap-3">
      <img src={iconSrc} alt={`${name} icon`} class="w-10 h-10 rounded-xl shadow-lg" loading="lazy" />
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2 flex-wrap">
          <h3 class="text-base font-bold text-white group-hover:text-brand-400 transition-colors">{name}</h3>
          <span class="text-[10px] font-medium px-2 py-0.5 rounded-full bg-white/5 text-gray-400 border border-white/5">{platformBadge}</span>
        </div>
        <p class="text-sm font-medium text-brand-400 mt-1">{tagline}</p>
      </div>
    </div>
    <p class="text-sm text-gray-400 mt-3 leading-relaxed">{description}</p>
    <div class="mt-4 flex items-center justify-between">
      <span class="text-xs text-gray-400">Free to start</span>
      <span class="text-sm font-semibold text-brand-400 group-hover:translate-x-1 transition-transform duration-200">{cta} →</span>
    </div>
  </div>
</a>
