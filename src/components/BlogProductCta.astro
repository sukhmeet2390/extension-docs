---
import { findProduct } from '../data/products';

interface Props {
  productSlugs?: string[];
  postSlug?: string;
}

const { productSlugs = [], postSlug } = Astro.props;
// The first related product is the post's primary product (multi-product round-ups list it first).
const product = productSlugs.length > 0 ? findProduct(productSlugs[0]) : undefined;
const ctaUrl = product
  ? `/${product.slug}/?utm_source=amrita-labs&utm_medium=owned-content&utm_campaign=${product.slug}_blog&utm_content=${postSlug ? `${postSlug}-cta` : 'blog-cta'}`
  : undefined;
---

{product && ctaUrl && (
  <aside class="mt-12 rounded-2xl bg-gray-900 px-6 py-7 text-white sm:flex sm:items-center sm:justify-between sm:gap-8">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-brand-300">Try it free</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight">{product.name}</h2>
      <p class="mt-2 text-sm leading-relaxed text-gray-300">{product.tagline}.</p>
    </div>
    <a
      href={ctaUrl}
      class="mt-5 inline-flex shrink-0 items-center justify-center rounded-lg bg-brand-500 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-400 sm:mt-0"
    >
      {product.category === 'chrome' ? 'Try free on Chrome' : 'Explore the app'}
    </a>
  </aside>
)}
