---
interface Props {
  icon: string;
  title: string;
  description: string;
}

const { icon, title, description } = Astro.props;
---

<div class="bg-surface-800 border border-white/5 rounded-xl p-5 hover:border-brand-500/20 hover:shadow-sm transition-all">
  <span class="text-2xl">{icon}</span>
  <h3 class="text-base font-semibold text-white mt-3">{title}</h3>
  <p class="text-sm text-gray-400 mt-2 leading-relaxed">{description}</p>
</div>
